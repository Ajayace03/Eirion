# ── AI APIs ──────────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com → API Keys
GEMINI_API_KEY=

# ── Authentication (Clerk) ───────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → your app → API Keys
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=
# Set this to your Clerk app's audience value if JWT audience verification is needed
CLERK_AUDIENCE=

# ── Database ─────────────────────────────────────────────────────────────────
# Also used by docker-compose.yml — must match POSTGRES_* values below
DATABASE_URL=postgresql://eirion:CHANGE_ME@localhost:5432/eirion_db
POSTGRES_USER=eirion
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eirion_db

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost
